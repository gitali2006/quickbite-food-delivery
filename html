                <input type="hidden" name="menuItemId" th:value="${item.id}">
                <input class="qty-input" type="number" name="quantity" value="1" min="1">
                <button type="submit" class="btn btn-sm btn-orange">Add to cart</button>
            </form>
        </div>
    </div>

    <div class="section-title" th:if="${!#lists.isEmpty(recentOrders)}">
        <h2>My latest orders</h2>
        <a th:href="@{/customer/orders}" class="btn btn-sm btn-outline">Full history</a>
    </div>
    <div class="table-wrap" th:if="${!#lists.isEmpty(recentOrders)}">
        <table class="table">
            <thead>
            <tr><th>Order</th><th>Restaurant</th><th>Items</th><th>Total (Rs.)</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
            <tr th:each="order : ${recentOrders}">
                <td th:text="${order.orderNumber}">ORD-1</td>
                <td th:text="${order.restaurant.name}">Restaurant</td>
                <td th:text="${order.itemCount}">0</td>
                <td th:text="${#numbers.formatDecimal(order.totalAmount, 1, 'COMMA', 2, 'POINT')}">0.00</td>
                <td><span class="badge" th:classappend="${order.status.cssClass}" th:text="${order.status.label}">Status</span></td>
                <td><a th:href="@{/customer/orders/{id}(id=${order.id})}" class="btn btn-sm btn-outline">Track</a></td>
            </tr>
            </tbody>
        </table>
    </div>
</main>

<div th:replace="~{fragments/layout :: footer}"></div>
</body>
</html>

