<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>QuickBite - My profile</title>
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>
<div th:replace="~{fragments/layout :: nav}"></div>

<main class="container">
    <div class="page-head">
        <div>
            <h1>My profile</h1>
            <p class="muted">Update your details or change your password (stored as a BCrypt hash).</p>
        </div>
    </div>

    <div class="card">
        <div style="display:flex; gap:16px; align-items:center; margin-bottom:14px;">
            <span class="avatar" th:text="${customer.initials}" style="width:64px;height:64px;font-size:1.4rem;">KP</span>
            <div>
                <h2 style="margin:0" th:text="${customer.name}">Kasun Perera</h2>
                <span class="chip" th:text="${customer.role}">CUSTOMER</span>
                <span class="badge" th:classappend="${customer.active} ? 'status-delivered' : 'status-cancelled'"
                      th:text="${customer.active} ? 'Active' : 'Disabled'">Active</span>
                <span class="chip hash-chip">&#128274; password is hashed</span>
            </div>
        </div>

        <dl class="kv mb">
            <dt>Customer ID</dt>
            <dd th:text="${customer.id}">1</dd>
            <dt>E-mail (login)</dt>
            <dd th:text="${customer.email}">kasun@example.com</dd>
            <dt>Loyalty points</dt>
            <dd th:text="${customer.loyaltyPoints} + ' points (10 per delivered order)'">0</dd>
            <dt>Member since</dt>
            <dd th:text="${customer.createdAt != null ? #temporals.format(customer.createdAt, 'dd MMM yyyy') : '-'}">-</dd>
        </dl>

        <h2 class="mt">Edit my details</h2>
        <form th:action="@{/customer/profile}" method="post">
            <div class="form-grid">
                <div class="form-group">
                    <label for="name">Full name *</label>
                    <input type="text" id="name" name="name" th:value="${customer.name}" required>
                </div>
                <div class="form-group">
                    <label for="email">E-mail (login) *</label>
                    <input type="email" id="email" name="email" th:value="${customer.email}" required>
                </div>
                <div class="form-group">
                    <label for="phone">Phone</label>
                    <input type="text" id="phone" name="phone" th:value="${customer.phone}" placeholder="0771234567">
                </div>
                <div class="form-group">
                    <label for="newPassword">New password <span class="muted">(leave blank to keep the current one)</span></label>
                    <input type="password" id="newPassword" name="newPassword" placeholder="••••••••">
                </div>
                <div class="form-group full">
                    <label for="address">Delivery address</label>
                    <textarea id="address" name="address" th:text="${customer.address}"
                              placeholder="House number, street, city"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn">Save changes</button>
                <a th:href="@{/customer}" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</main>

<div th:replace="~{fragments/layout :: footer}"></div>
</body>
</html>