```html
<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>QuickBite - Create your customer account</title>
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>
<div th:replace="~{fragments/layout :: nav}"></div>

<main class="container">
    <div class="auth-wrap">
        <div class="card auth-card">
            <div class="center">
                <span style="font-size:2.6rem;">&#128100;</span>
                <h1 style="margin-bottom:2px;">Create your account</h1>
                <p class="muted">Customer sign-up &mdash; order food, track deliveries, pay online and write reviews.</p>
            </div>

            <div class="alert alert-error" th:if="${error}" th:text="${error}">error</div>
            <div class="alert alert-success" th:if="${success}" th:text="${success}">success</div>

            <form th:action="@{/register}" method="post">
                <div class="form-group mb">
                    <label for="name">Full name <span class="required">*</span></label>
                    <input type="text" id="name" name="name" required maxlength="80"
                           placeholder="Kasun Perera" autofocus>
                </div>
                <div class="form-group mb">
                    <label for="email">E-mail <span class="required">*</span></label>
                    <input type="email" id="email" name="email" required maxlength="120"
                           placeholder="you@example.com">
                </div>
                <div class="form-group mb">
                    <label for="phone">Phone number</label>
                    <input type="text" id="phone" name="phone" maxlength="20"
                           placeholder="077 123 4567">
                </div>
                <div class="form-group mb">
                    <label for="password">Password <span class="required">*</span></label>
                    <input type="password" id="password" name="password" required minlength="4"
                           placeholder="at least 4 characters">
                </div>
                <div class="form-group mb">
                    <label for="confirmPassword">Confirm password <span class="required">*</span></label>
                    <input type="password" id="confirmPassword" name="confirmPassword" required minlength="4"
                           placeholder="type the same password again">
                </div>
                <button type="submit" class="btn" style="width:100%">Create my account</button>
            </form>

            <p class="muted center" style="font-size:0.85rem;">
                Your <strong>delivery address</strong> is not asked here &mdash; add it (and change it)
                any time in <strong>My profile</strong> after signing in, or type it at checkout.
            </p>

            <div class="alert alert-info mt">
                &#128274; Your password is stored in the database as a <strong>BCrypt hash</strong>
                (60 characters, starting with <code>$2a$</code>) &mdash; never as plain text.
            </div>

            <p class="center mt">
                <span class="muted">Already have an account?</span>
                <a th:href="@{/login}"><strong>Sign in</strong></a>
            </p>
            <p class="center muted" style="font-size:0.85rem;">
                This page creates <strong>customer</strong> accounts only.
                Administrator e-mail accounts are created by an existing admin
                in the admin area (<a th:href="@{/login}">/admin/admins</a>).
            </p>
        </div>
    </div>
</main>

<div th:replace="~{fragments/layout :: footer}"></div>
</body>
</html>

